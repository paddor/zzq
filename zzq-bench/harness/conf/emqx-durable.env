# EMQX 6.3.2 tuned (emqx-tuned.env) with durable sessions: messages to
# sessions with an expiry go to the builtin Raft store, fdatasync per WAL
# batch. Session state is saved each second (default 15 s). The PUBACK does
# not wait for either.
EMQX_MQTT__MAX_INFLIGHT=1000
EMQX_MQTT__MAX_MQUEUE_LEN=100000
EMQX_MQTT__MAX_AWAITING_REL=1000
EMQX_FORCE_SHUTDOWN__MAX_MAILBOX_SIZE=100000
EMQX_FORCE_SHUTDOWN__MAX_HEAP_SIZE=1GB
EMQX_DURABLE_SESSIONS__ENABLE=true
EMQX_DURABLE_SESSIONS__CHECKPOINT_INTERVAL=1s
