# A node of a 3-node TBMQ 2.4.1 cluster for the failover suite:
# tbmq-tuned.env with a 2 GiB heap per node and no WebSocket listener,
# whose port would clash with another node's. The suite sets each node's
# ID and ports.
JAVA_OPTS=-Xms2g -Xmx2g -Xss384k -XX:+AlwaysPreTouch
LISTENER_WS_ENABLED=false
MQTT_MAX_IN_FLIGHT_MSGS=1000
MQTT_FLOW_CONTROL_ENABLED=true
MQTT_FLOW_CONTROL_DELAYED_QUEUE_MAX_SIZE=100000
NETTY_WRITE_BUFFER_HIGH_WATER_MARK=65536
NETTY_WRITE_BUFFER_LOW_WATER_MARK=32768
TB_CLIENT_SESSION_EVENT_MAX_PENDING_REQUESTS=100000
MQTT_TOTAL_RATE_LIMITS_ENABLED=false
MQTT_INCOMING_RATE_LIMITS_ENABLED=false
MQTT_OUTGOING_RATE_LIMITS_ENABLED=false
MQTT_DEVICE_PERSISTED_MSGS_RATE_LIMITS_ENABLED=false
MQTT_SESSIONS_LIMIT=0
MQTT_APPLICATION_CLIENTS_LIMIT=0
