# tbmq-tuned.env, and nothing given up on: Kafka writes acked by all
# replicas, failed processing retried, the most messages a persistent
# client keeps (65535). The suite runs Kafka with a sync per message and
# Valkey with a sync per write. The PUBACK waits for the Kafka write.
JAVA_OPTS=-Xms8g -Xmx8g -Xss384k -XX:+AlwaysPreTouch
MQTT_MAX_IN_FLIGHT_MSGS=1000
MQTT_FLOW_CONTROL_ENABLED=true
MQTT_FLOW_CONTROL_DELAYED_QUEUE_MAX_SIZE=100000
# KB: past 64 MiB waiting on a socket, messages to it are dropped.
NETTY_WRITE_BUFFER_HIGH_WATER_MARK=65536
NETTY_WRITE_BUFFER_LOW_WATER_MARK=32768
TB_CLIENT_SESSION_EVENT_MAX_PENDING_REQUESTS=100000
MQTT_TOTAL_RATE_LIMITS_ENABLED=false
MQTT_INCOMING_RATE_LIMITS_ENABLED=false
MQTT_OUTGOING_RATE_LIMITS_ENABLED=false
MQTT_DEVICE_PERSISTED_MSGS_RATE_LIMITS_ENABLED=false
MQTT_SESSIONS_LIMIT=0
MQTT_APPLICATION_CLIENTS_LIMIT=0
TB_KAFKA_DEFAULT_PRODUCER_ACKS=all
TB_KAFKA_DEFAULT_PRODUCER_RETRIES=2147483647
TB_MSG_ALL_ACK_STRATEGY_TYPE=RETRY_ALL
TB_MSG_ALL_ACK_STRATEGY_RETRIES=0
TB_DEVICE_PERSISTED_MSG_ACK_STRATEGY_TYPE=RETRY_ALL
TB_DEVICE_PERSISTED_MSG_ACK_STRATEGY_RETRIES=0
MQTT_PERSISTENT_SESSION_DEVICE_PERSISTED_MESSAGES_LIMIT=65535
